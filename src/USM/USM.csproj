<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>USM</AssemblyName>
    <RootNamespace>USM</RootNamespace>
    <ApplicationTitle>Unplugged Song Manager</ApplicationTitle>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Authors>TheLucXas</Authors>
    <PcModProject>$(MSBuildProjectDirectory)\..\..\mod\UnpluggedCustomSongs\UnpluggedCustomSongs.csproj</PcModProject>
    <PcModAssembly>$(MSBuildProjectDirectory)\..\..\mod\UnpluggedCustomSongs\bin\$(Configuration)\netstandard2.0\UnpluggedCustomSongs.dll</PcModAssembly>
    <PcGameAssembly>C:\SteamLibrary\steamapps\common\Unplugged\Unplugged_Data\Managed\Assembly-CSharp.dll</PcGameAssembly>
    <QuestModProject>$(MSBuildProjectDirectory)\..\..\mod\UnpluggedCustomSongs\UnpluggedCustomSongs.Quest.csproj</QuestModProject>
    <QuestModAssembly>$(MSBuildProjectDirectory)\..\..\mod\UnpluggedCustomSongs\bin\$(Configuration)\net8.0\UnpluggedCustomSongs.Quest.dll</QuestModAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="assets\icon.png" />
    <Resource Include="assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(QuestModProject)" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="$(PcModProject)" Condition="Exists('$(PcGameAssembly)')" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\ffmpeg.exe" Condition="Exists('..\..\ffmpeg.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup><None Include="Resources\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None></ItemGroup>

  <Target Name="CopyQuestModToBuildOutput" AfterTargets="Build">
    <Copy SourceFiles="$(QuestModAssembly)" DestinationFiles="$(OutputPath)UnpluggedCustomSongs.Quest.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PcModAssembly)" DestinationFiles="$(OutputPath)UnpluggedCustomSongs.dll" SkipUnchangedFiles="true" Condition="Exists('$(PcModAssembly)')" />
    <Copy SourceFiles="$(PcModAssembly)" DestinationFiles="$(OutputPath)UnpluggedCustomSongs.PC.dll" SkipUnchangedFiles="true" Condition="Exists('$(PcModAssembly)')" />
  </Target>

  <Target Name="CopyQuestModToPublishOutput" AfterTargets="Publish">
    <Copy SourceFiles="$(QuestModAssembly)" DestinationFiles="$(PublishDir)UnpluggedCustomSongs.Quest.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PcModAssembly)" DestinationFiles="$(PublishDir)UnpluggedCustomSongs.dll" SkipUnchangedFiles="true" Condition="Exists('$(PcModAssembly)')" />
    <Copy SourceFiles="$(PcModAssembly)" DestinationFiles="$(PublishDir)UnpluggedCustomSongs.PC.dll" SkipUnchangedFiles="true" Condition="Exists('$(PcModAssembly)')" />
  </Target>
</Project>
