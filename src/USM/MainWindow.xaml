<Window x:Class="USM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:USM.ViewModels"
        xmlns:views="clr-namespace:USM.Views"
        mc:Ignorable="d"
        Title="USM • Unplugged Song Manager"
        Width="1040"
        Height="740"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgMain}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <views:StatusColorConverter x:Key="StatusColorConv" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- 1. Top Navbar / Header -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎸 USM"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentPink}" />
                    <TextBlock Text="UNPLUGGED SONG MANAGER"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"
                               Margin="12,2,0,0" />
                </StackPanel>

                <!-- Game Connection Badge -->
                <Border Grid.Column="2"
                        Background="{StaticResource BrushBgInput}"
                        CornerRadius="8"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="●"
                                   FontSize="14"
                                   Foreground="{Binding IsGameConnected, Converter={StaticResource StatusColorConv}}"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="{Binding GameStatusText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Main TabControl -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="10,6,10,0">
            <TabControl.Resources>
                <!-- Sleek Dark TabItem Style -->
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="16,10" />
                    <Setter Property="Margin" Value="4,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8,8,0,0"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent"
                                        Padding="{TemplateBinding Padding}"
                                        Cursor="Hand">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BrushBgCard}" />
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BrushAccentPink}" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Chorus Search & Download -->
            <TabItem Header="🔍 Download (Chorus)">
                <views:SearchView DataContext="{Binding SearchVM}" />
            </TabItem>

            <!-- Tab 2: Local Converter Drag & Drop -->
            <TabItem Header="⚡ Local Converter">
                <views:ConverterView DataContext="{Binding ConverterVM}" />
            </TabItem>

            <!-- Tab 3: Song Library Manager -->
            <TabItem Header="📚 Song Library">
                <views:LibraryView DataContext="{Binding LibraryVM}" />
            </TabItem>

            <!-- Tab 4: Settings -->
            <TabItem Header="⚙ Settings">
                <views:SettingsView DataContext="{Binding SettingsVM}" />
            </TabItem>
        </TabControl>

        <!-- 3. Bottom Toast Notification Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <TextBlock Text="{Binding ToastMessage}"
                       Foreground="{StaticResource BrushAccentGreen}"
                       FontSize="11"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
