<Window x:Class="USM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:USM.ViewModels"
        xmlns:views="clr-namespace:USM.Views"
        mc:Ignorable="d"
        Title="USM • Unplugged Song Manager"
        Icon="assets/icon.png"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="660"
        FontFamily="{StaticResource FontGlory}"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource BrushTextPrimary}"
        Background="{StaticResource BrushBgMain}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <views:StatusColorConverter x:Key="StatusColorConv" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- 1. Top Navbar / Header -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="assets/icon.png"
                           Width="28"
                           Height="28"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="USM"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentPink}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="UNPLUGGED SONG MANAGER"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"
                               Margin="12,2,0,0" />
                </StackPanel>

                <!-- Actions & Connection Badge -->
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{Binding UpdateNoticeText}" Command="{Binding ShowUpdatesCommand}"
                            Visibility="{Binding HasAvailableUpdates, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource SecondaryButton}" Foreground="{StaticResource BrushAccentPink}"
                            Margin="0,2,8,2" MaxWidth="220" ToolTip="{Binding UpdateNoticeText}">
                        <Button.ContentTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" /></DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="{DynamicResource Loc_Nav_LaunchGame}"
                            Command="{Binding LaunchGameCommand}"
                            Background="{StaticResource BrushAccentGreen}"
                            Foreground="{StaticResource BrushTextOnAccent}"
                            FontWeight="Bold"
                            ContentTemplate="{StaticResource WrappingButtonContent}"
                            Margin="0,2,8,2"
                            ToolTip="{DynamicResource Loc_Nav_LaunchGame_Tooltip}" />
                    <Button Content="{DynamicResource Loc_Nav_LaunchQuest}"
                            ContentTemplate="{StaticResource WrappingButtonContent}"
                            Command="{Binding LaunchQuestGameCommand}"
                            Visibility="{Binding CanLaunchQuestGame, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource BrushAccentGreen}"
                            Foreground="{StaticResource BrushTextOnAccent}"
                            FontWeight="Bold"
                            Margin="0,2,8,2" />

                    <!-- Game Connection Badge -->
                    <Border Background="{StaticResource BrushBgInput}"
                            CornerRadius="8"
                            Padding="12,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="●"
                                       FontSize="14"
                                       Foreground="{Binding IsGameConnected, Converter={StaticResource StatusColorConv}}"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="{Binding GameStatusText}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Button Grid.Row="1" Grid.ColumnSpan="3"
                        Content="{Binding ChartAttentionText}"
                        Command="{Binding ShowChartAttentionCommand}"
                        Visibility="{Binding HasChartAttention, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource SecondaryButton}"
                        Foreground="{StaticResource BrushAccentYellow}"
                        HorizontalContentAlignment="Left"
                        Margin="0,8,0,0"
                        ToolTip="{Binding ChartAttentionText}" />
            </Grid>
        </Border>

        <!-- 2. Main TabControl -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    TabStripPlacement="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="12,8,12,0">
            <TabControl.Resources>
                <!-- Fluent-style left navigation used throughout the app. -->
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Width" Value="208" />
                    <Setter Property="Height" Value="46" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,2,8,2" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="NavItemBackground"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}"
                                        Cursor="Hand"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="SelectionIndicator"
                                                Grid.Column="0"
                                                Width="3"
                                                Height="22"
                                                CornerRadius="2"
                                                Background="{StaticResource BrushAccentBlue}"
                                                Visibility="Collapsed"
                                                VerticalAlignment="Center" />
                                        <ContentPresenter Grid.Column="1"
                                                          ContentSource="Header"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="NavItemBackground" Property="Background" Value="{StaticResource BrushBgCardHover}" />
                                        <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NavItemBackground" Property="Background" Value="{StaticResource BrushBgCardHover}" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="NavItemBackground" Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="226" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource BrushBgCard}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,14"
                                Margin="0,0,12,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="{DynamicResource Loc_Nav_Menu}"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="12,2,0,12" />
                                <TabPanel Grid.Row="1"
                                          x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1" />
                            </Grid>
                        </Border>

                        <ContentPresenter Grid.Column="1"
                                          x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- Tab 1: Chorus Search & Download -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Tab_Download}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:SearchView DataContext="{Binding SearchVM}" />
            </TabItem>

            <!-- Tab 2: Local Converter Drag & Drop -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Tab_Converter}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:ConverterView DataContext="{Binding ConverterVM}" />
            </TabItem>

            <!-- Tab 3: Song Library Manager -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Tab_Library}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:LibraryView DataContext="{Binding LibraryVM}" />
            </TabItem>

            <!-- Tab 4: Quest Patcher -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Tab_QuestPatcher}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:QuestView DataContext="{Binding QuestVM}" />
            </TabItem>

            <!-- Tab 5: Settings -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Tab_Settings}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:SettingsView DataContext="{Binding SettingsVM}" />
            </TabItem>
        </TabControl>

        <!-- 3. Bottom Toast Notification Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <TextBlock Text="{Binding ToastMessage}"
                       Foreground="{StaticResource BrushAccentGreen}"
                       FontSize="11"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
