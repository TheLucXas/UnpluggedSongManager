<UserControl x:Class="USM.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:USM.ViewModels"
             xmlns:local="clr-namespace:USM.Views"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:LibraryViewModel}"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="SongCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushBgCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushBgCardHover}" />
                    <Setter Property="BorderBrush" Value="#3E4256" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#251624" />
                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentPink}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,10,20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Search Card -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,14"
                Margin="0,0,0,10">
            <StackPanel>
                <!-- Top Row: Title, Badge, Open Folder, Refresh -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Installed Custom Songs"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center" />

                    <!-- Count Badge -->
                    <Border Grid.Column="1"
                            Background="{StaticResource BrushBgInput}"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SongCountText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentBlue}" />
                    </Border>

                    <!-- Top Right Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="📁 Open CustomSongs"
                                Command="{Binding OpenCustomSongsCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Padding="12,6"
                                FontSize="12" />

                        <Button Content="🔄 Refresh"
                                Command="{Binding RefreshCommand}"
                                Padding="14,6"
                                FontSize="12" />
                    </StackPanel>
                </Grid>

                <!-- Filter & Batch Action Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Filter Search Box -->
                    <TextBox Grid.Column="0"
                             Text="{Binding FilterQuery, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13"
                             Margin="0,0,10,0" />

                    <!-- Audio Track Type Filter -->
                    <ComboBox Grid.Column="1"
                              SelectedIndex="{Binding SelectedTrackTypeFilterIndex}"
                              Width="190"
                              Height="34"
                              Margin="0,0,8,0">
                        <ComboBoxItem Content="All Audio Types" />
                        <ComboBoxItem Content="Full MultiTrack" />
                        <ComboBoxItem Content="2-Track (Instrumental + Vocals)" />
                        <ComboBoxItem Content="Single Track" />
                    </ComboBox>

                    <!-- Select All Button -->
                    <Button Grid.Column="2"
                            Content="{Binding SelectAllText}"
                            Command="{Binding ToggleSelectAllCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Padding="14,7"
                            FontSize="12" />

                    <!-- Delete Selected Button -->
                    <Button Grid.Column="3"
                            Content="{Binding DeleteSelectedText}"
                            Command="{Binding DeleteSelectedCommand}"
                            Style="{StaticResource DangerButton}"
                            Padding="14,7"
                            FontSize="12" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Song Cards Scrollable List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DisplayedSongs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SongCardStyle}"
                                MouseLeftButtonUp="SongCard_MouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Modern Selection Indicator Circle -->
                                <Border Grid.Column="0"
                                        Width="22"
                                        Height="22"
                                        CornerRadius="11"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushAccentPink}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentPink}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="✓"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                </Border>

                                <!-- Album Thumbnail -->
                                <Border Grid.Column="1"
                                        Width="58"
                                        Height="58"
                                        CornerRadius="6"
                                        Background="{StaticResource BrushBgInput}">
                                    <Grid>
                                        <TextBlock Text="🎸"
                                                   FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding CoverImage}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <!-- Title, Artist, Charter & Audio Layout Badge -->
                                <StackPanel Grid.Column="2" Margin="14,0,14,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Verified Audio Layout Badge -->
                                        <Border CornerRadius="4"
                                                Padding="6,2"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource BrushBgInput}">
                                            <TextBlock Text="{Binding TrackTypeDisplay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding IsMultiTrack, Converter={x:Static local:LibraryView.MultiTrackColorConverter}}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Artist}"
                                               FontSize="13"
                                               Foreground="{StaticResource BrushAccentBlue}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Text="{Binding Charter, StringFormat='Charter: {0}'}"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Preview Button -->
                                    <Button Content="{Binding IsPlaying, Converter={x:Static local:LibraryView.PlayIconConverter}}"
                                            Command="{Binding DataContext.PreviewSongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="Play / Stop Preview" />

                                    <!-- Open Folder Button -->
                                    <Button Content="📂"
                                            Command="{Binding DataContext.OpenSongFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"
                                            Margin="6,0,0,0"
                                            ToolTip="Open Folder in File Explorer" />

                                    <!-- Delete Button -->
                                    <Button Content="🗑"
                                            Command="{Binding DataContext.DeleteSongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconDangerButton}"
                                            Margin="6,0,0,0"
                                            ToolTip="Delete Song" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
