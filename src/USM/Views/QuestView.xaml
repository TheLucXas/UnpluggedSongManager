<UserControl x:Class="USM.Views.QuestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:USM.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:QuestViewModel}"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10,20,20">

            <!-- 1. Headset ADB Connection Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🥽" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Meta Quest ADB Connection"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="🔄 Refresh Devices"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshDevicesCommand}"
                                Padding="12,6" />
                    </Grid>

                    <!-- Connection Controls Grid -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Connected Devices List -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Detected Quest Headsets"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedDevice}"
                                      DisplayMemberPath="DisplayName"
                                      Height="36" />
                        </StackPanel>

                        <!-- Right: Wireless IP:Port Connection -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Wireless ADB (Wi-Fi Connection)"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding WirelessIp, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Quest IP Address (e.g. 192.168.1.15)"
                                         Height="36" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding WirelessPort, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="ADB Port (default 5555)"
                                         Height="36" />
                                <Button Grid.Column="4"
                                        Content="📡 Connect Wi-Fi"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ConnectWirelessCommand}"
                                        Padding="14,0"
                                        Height="36" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Device Status Banner -->
                    <Border Background="{StaticResource BrushBgInput}"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Status: "
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="{Binding PackageStatusText}"
                                       Foreground="{StaticResource BrushAccentBlue}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. Source APK Options Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Source APK Configuration"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               Margin="0,0,0,8" />
                    <CheckBox Content="Use custom local APK file (instead of pulling directly from Quest)"
                              IsChecked="{Binding UseCustomApk}"
                              Foreground="{StaticResource BrushTextSecondary}"
                              FontSize="12"
                              Margin="0,0,0,8" />

                    <Grid Visibility="{Binding UseCustomApk, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding CustomApkPath, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" />
                        <Button Grid.Column="2"
                                Content="📂 Browse APK..."
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseApkCommand}"
                                Padding="14,0"
                                Height="36" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Actions Grid: Patching & Song Sync -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Patch & Deploy Standalone App -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="⚡ Quest Standalone Modder"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentPink}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Extracts the game from your Quest, clones it into a separate app ('Unplugged Modded'), adds storage permissions for custom songs, rebuilds and reinstalls it alongside your original app."
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   Margin="0,0,0,14" />
                        <Button Content="🚀 Patch &amp; Deploy 'Unplugged Modded'"
                                Command="{Binding StartPatchCommand}"
                                Height="40"
                                FontSize="13"
                                FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Right: Custom Songs Sync -->
                <Border Grid.Column="2"
                        Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="🎵 Custom Songs Transfer"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentPurple}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Pushes all custom songs from your USM library directly to your Quest storage (/sdcard/Unplugged/Songs) ready to play."
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   Margin="0,0,0,14" />
                        <Button Content="📂 Sync Songs to Quest"
                                Style="{StaticResource PurpleButton}"
                                Command="{Binding SyncSongsCommand}"
                                Height="40"
                                FontSize="13"
                                FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Progress Bar & Status -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{Binding ProgressStatus}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccentGreen}" />
                        <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}"
                                   HorizontalAlignment="Right"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Grid>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" />
                </StackPanel>
            </Border>

            <!-- 5. Live Console / Log Output Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📟" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="ADB &amp; Patcher Console Log"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="Clear Logs"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearLogsCommand}"
                                Padding="10,4"
                                FontSize="11" />
                    </Grid>

                    <Border Background="#0A0B10"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Height="180">
                        <TextBox x:Name="LogTextBox"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 Background="Transparent"
                                 Foreground="#22C55E"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 FontSize="12"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="LogTextBox_TextChanged" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
