<UserControl x:Class="USM.Views.QuestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:USM.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:QuestViewModel}"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10,20,20">

            <!-- 1. Headset ADB Connection Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🥽" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_Quest_ConnectionTitle}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{DynamicResource Loc_Quest_RefreshDevices}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshDevicesCommand}"
                                Padding="12,6" />
                    </Grid>

                    <!-- Connection Controls Grid -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Connected Devices List -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Loc_Quest_DetectedHeadset}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource Loc_Quest_SelectHeadsetHint}"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Devices}"
                                       SelectedItem="{Binding SelectedDevice}"
                                       DisplayMemberPath="DisplayName"
                                       Height="36" />
                        </StackPanel>

                        <!-- Right: Wireless IP:Port Connection -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Loc_Quest_WirelessTitle}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Long bar: IP -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Loc_Quest_IpLabel}"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding WirelessIp, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WirelessInputTextBox}"
                                             ToolTip="{DynamicResource Loc_Quest_IpTooltip}"
                                             MinWidth="120" />
                                </StackPanel>

                                <!-- Short bar: Port -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Loc_Quest_PortLabel}"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding WirelessPort, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WirelessInputTextBox}"
                                             ToolTip="{DynamicResource Loc_Quest_PortTooltip}"
                                             MinWidth="72" />
                                </StackPanel>

                                <!-- Button -->
                                <Button Grid.Column="4"
                                        VerticalAlignment="Bottom"
                                        Content="{DynamicResource Loc_Quest_ConnectWifi}"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ConnectWirelessCommand}"
                                        Padding="14,0"
                                        Height="36" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Device & Tools Status Banner -->
                    <Border Background="{StaticResource BrushBgInput}"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Status: "
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding PackageStatusText}"
                                           Foreground="{StaticResource BrushAccentBlue}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding QuestToolsStatusText}"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Button Content="{DynamicResource Loc_Quest_DownloadToolsBtn}"
                                        Command="{Binding DownloadQuestToolsCommand}"
                                        Visibility="{Binding NeedsQuestTools, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,3"
                                        FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. Source APK Options Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_Quest_SourceConfigTitle}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               Margin="0,0,0,8" />
                    <CheckBox Content="{DynamicResource Loc_Quest_UseCustomApk}"
                              IsChecked="{Binding UseCustomApk}"
                              Foreground="{StaticResource BrushTextSecondary}"
                              FontSize="12"
                              Margin="0,0,0,8" />

                    <Grid Visibility="{Binding UseCustomApk, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding CustomApkPath, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" />
                        <Button Grid.Column="2"
                                Content="{DynamicResource Loc_Quest_BrowseApk}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseApkCommand}"
                                Padding="14,0"
                                Height="36" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,10,0,10" />

                    <!-- Mod Options -->
                    <CheckBox Content="{DynamicResource Loc_Quest_SkipIntroTitle}"
                              IsChecked="{Binding SkipIntroAndUnlockCampaign}"
                              Foreground="{StaticResource BrushTextPrimary}"
                              FontWeight="SemiBold"
                              FontSize="12"
                              Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource Loc_Quest_SkipIntroDesc}"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap"
                               Margin="50,0,0,0" />
                </StackPanel>
            </Border>

            <!-- 3. Actions Grid: Patching & Song Sync -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Patch & Deploy Standalone App -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_Quest_StandaloneModderTitle}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentPink}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding PatchButtonDescription}"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   Margin="0,0,0,14" />
                        <Button Content="{Binding PatchButtonText}"
                                Command="{Binding StartPatchCommand}"
                                Height="40"
                                FontSize="13"
                                FontWeight="Bold" />
                        <Button Content="{DynamicResource Loc_Quest_ImportPcSaveButton}"
                                Command="{Binding ImportPcSaveCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="36"
                                FontSize="12"
                                Margin="0,8,0,0" />
                        <TextBlock Text="{DynamicResource Loc_Quest_ImportPcSaveDesc}"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <Button Content="{DynamicResource Loc_Quest_UninstallButton}"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding UninstallModdedCommand}"
                                Visibility="{Binding CanUninstallModded, Converter={StaticResource BoolToVis}}"
                                Height="34"
                                FontSize="12"
                                Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Right: Custom Songs Sync -->
                <Border Grid.Column="2"
                        Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_Quest_CustomSongsSyncTitle}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentPurple}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource Loc_Quest_CustomSongsSyncDesc}"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   Margin="0,0,0,14" />
                        <Button Content="{DynamicResource Loc_Quest_SyncSongsButton}"
                                Style="{StaticResource PurpleButton}"
                                Command="{Binding SyncSongsCommand}"
                                Height="40"
                                FontSize="13"
                                FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Progress Bar & Status -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{Binding ProgressStatus}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccentGreen}" />
                        <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}"
                                   HorizontalAlignment="Right"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Grid>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" />
                </StackPanel>
            </Border>

            <!-- 5. Live Console / Log Output Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📟" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_Quest_ConsoleLogTitle}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="{DynamicResource Loc_Quest_ClearLogs}"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearLogsCommand}"
                                Padding="10,4"
                                FontSize="11" />
                    </Grid>

                    <Border Background="#0A0B10"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Height="180">
                        <TextBox x:Name="LogTextBox"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 Background="Transparent"
                                 Foreground="#22C55E"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 FontSize="12"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="LogTextBox_TextChanged" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
