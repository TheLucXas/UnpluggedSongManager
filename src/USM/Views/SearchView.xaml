<UserControl x:Class="USM.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:USM.ViewModels"
             xmlns:views="clr-namespace:USM.Views"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SearchViewModel}"
             Background="Transparent">
    <UserControl.Resources>
        <views:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>
    <Grid Margin="20,10,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Top Search Box Card -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Margin="0,0,12,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1"
                        Content="Search Charts"
                        Command="{Binding SearchCommand}"
                        Padding="24,10"
                        FontSize="13"
                        FontWeight="Bold" />
            </Grid>
        </Border>

        <!-- 2. Filters & Sorting Toolbar -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Sort ComboBox -->
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2" VerticalAlignment="Center">
                    <TextBlock Text="Sort:"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox SelectedIndex="{Binding SelectedSortIndex}"
                              Width="160"
                              Height="32">
                        <ComboBoxItem Content="⚡ Relevance (Default)" />
                        <ComboBoxItem Content="🕒 Newest (Más Nuevas)" />
                        <ComboBoxItem Content="🔤 Title (A - Z)" />
                        <ComboBoxItem Content="👤 Artist (A - Z)" />
                        <ComboBoxItem Content="📅 Year (Newest)" />
                        <ComboBoxItem Content="⏳ Length (Longest)" />
                    </ComboBox>
                </StackPanel>

                <!-- Track Filter ComboBox (MultiTrack) -->
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2" VerticalAlignment="Center">
                    <TextBlock Text="Tracks:"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox SelectedIndex="{Binding SelectedTrackFilterIndex}"
                              Width="155"
                              Height="32">
                        <ComboBoxItem Content="🌐 All Tracks" />
                        <ComboBoxItem Content="🎛️ MultiTrack Only" />
                        <ComboBoxItem Content="🎸 Single Track Only" />
                    </ComboBox>
                </StackPanel>

                <!-- Difficulty Filter ComboBox -->
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2" VerticalAlignment="Center">
                    <TextBlock Text="Difficulty:"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox SelectedIndex="{Binding SelectedDifficultyFilterIndex}"
                              Width="155"
                              Height="32">
                        <ComboBoxItem Content="🎯 All Difficulties" />
                        <ComboBoxItem Content="🟢 Beginner (Tier 0-1)" />
                        <ComboBoxItem Content="🟡 Intermediate (Tier 2-3)" />
                        <ComboBoxItem Content="🔴 Expert (Tier 4+)" />
                    </ComboBox>
                </StackPanel>

                <!-- Status Filter ComboBox -->
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2" VerticalAlignment="Center">
                    <TextBlock Text="Status:"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox SelectedIndex="{Binding SelectedStatusFilterIndex}"
                              Width="145"
                              Height="32">
                        <ComboBoxItem Content="📦 All Status" />
                        <ComboBoxItem Content="📥 Not Installed" />
                        <ComboBoxItem Content="✓ Installed" />
                    </ComboBox>
                </StackPanel>

                <!-- Reset Filters Button -->
                <Button Content="Reset ↺"
                        Command="{Binding ResetFiltersCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,4"
                        Height="32"
                        FontSize="11"
                        Margin="0,2,0,2"
                        VerticalAlignment="Center" />
            </WrapPanel>
        </Border>

        <!-- 3. Status Header -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   Foreground="{StaticResource BrushTextSecondary}"
                   FontSize="13"
                   Margin="4,0,0,10" />

        <!-- 4. Search Results List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BrushBgCard}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>

                                <!-- Album Art or Placeholder -->
                                <Border Grid.Column="0"
                                        Width="64"
                                        Height="64"
                                        CornerRadius="6"
                                        Background="{StaticResource BrushBgInput}">
                                    <Grid>
                                        <TextBlock Text="🎵"
                                                   FontSize="28"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding ArtUrl}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <!-- Song Metadata -->
                                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="400"
                                                   VerticalAlignment="Center" />

                                        <!-- MultiTrack Badge -->
                                        <Border Background="#2E1B4E"
                                                BorderBrush="{StaticResource BrushAccentPurple}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsMultiTrack, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="🎛️ MULTITRACK"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#C084FC" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding SubtitleDisplay}"
                                               FontSize="13"
                                               Foreground="{StaticResource BrushAccentBlue}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Text="{Binding MetaDisplay}"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Actions & Progress -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Width="180">
                                    <!-- Download / Install Button -->
                                    <Button Content="{Binding StatusText}"
                                            Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanDownload}"
                                            Height="34"
                                            Padding="10,0"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Margin="0,0,0,4" />

                                    <!-- Progress bar when downloading/converting -->
                                    <ProgressBar Value="{Binding DownloadProgress}"
                                                 Maximum="1.0"
                                                 Height="6"
                                                 Margin="0,2,0,0"
                                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
