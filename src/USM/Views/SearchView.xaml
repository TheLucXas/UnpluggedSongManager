<UserControl x:Class="USM.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:USM.ViewModels"
             xmlns:views="clr-namespace:USM.Views"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SearchViewModel}"
             Background="Transparent">
    <UserControl.Resources>
        <views:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>
    <Grid Margin="20,10,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Top Search Box Card -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Margin="0,0,12,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button ContentTemplate="{StaticResource WrappingButtonContent}" Grid.Column="1"
                        Content="{DynamicResource Loc_Search_SearchCharts}"
                        Command="{Binding SearchCommand}"
                        FontWeight="Bold" />
            </Grid>
        </Border>

        <!-- 2. Filters & Sorting Toolbar -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Sort ComboBox -->
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_Search_SortLabel}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox SelectedIndex="{Binding SelectedSortIndex}"
                              Width="180"
                              Height="32">
                        <ComboBoxItem Content="{DynamicResource Loc_Search_SortRelevance}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_SortNewest}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_SortTitle}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_SortArtist}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_SortDuration}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_SortAlbum}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_SortGenre}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_SortYear}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_SortCharter}" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,16,2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_Search_OrderLabel}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox SelectedIndex="{Binding SelectedSortDirectionIndex}"
                              Width="112"
                              Height="32"
                              IsEnabled="{Binding CanChooseSortDirection}">
                        <ComboBoxItem Content="{DynamicResource Loc_Search_OrderDefault}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_OrderAscending}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_OrderDescending}" />
                    </ComboBox>
                </StackPanel>

                <!-- Difficulty Filter ComboBox -->
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_Search_DifficultyLabel}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox SelectedIndex="{Binding SelectedDifficultyFilterIndex}"
                              Width="155"
                              Height="32">
                        <ComboBoxItem Content="{DynamicResource Loc_Search_DifficultyAll}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_DifficultyBeginner}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_DifficultyIntermediate}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_DifficultyExpert}" />
                    </ComboBox>
                </StackPanel>

                <!-- Status Filter ComboBox -->
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_Search_StatusLabel}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox SelectedIndex="{Binding SelectedStatusFilterIndex}"
                              Width="130"
                              Height="32">
                        <ComboBoxItem Content="{DynamicResource Loc_Search_StatusAll}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_StatusNotInstalled}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_StatusInstalled}" />
                    </ComboBox>
                </StackPanel>

                <!-- Audio layout filter -->
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_Search_TrackTypeLabel}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox SelectedIndex="{Binding SelectedAudioLayoutFilterIndex}"
                              Width="145"
                              Height="32">
                        <ComboBoxItem Content="{DynamicResource Loc_Search_TrackTypeAll}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_SingleTrack}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_HalfTrack}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_MultiTrack}" />
                    </ComboBox>
                </StackPanel>

                <!-- Chart coverage filter -->
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_Search_ChartQualityLabel}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox SelectedIndex="{Binding SelectedChartQualityFilterIndex}"
                              Width="185"
                              Height="32"
                              ToolTip="{DynamicResource Loc_Search_ChartQualityTooltip}">
                        <ComboBoxItem Content="{DynamicResource Loc_Search_ChartQualityAll}" />
                        <ComboBoxItem Content="{DynamicResource Loc_Search_HideIncompleteCharts}" />
                    </ComboBox>
                </StackPanel>

                <!-- Reset Filters Button -->
                <Button ContentTemplate="{StaticResource WrappingButtonContent}" Content="{DynamicResource Loc_Search_ResetFilters}"
                        Command="{Binding ResetFiltersCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,2,0,2"
                        VerticalAlignment="Center" />
            </WrapPanel>
        </Border>

        <!-- 3. Status Header -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   Foreground="{StaticResource BrushTextSecondary}"
                   FontSize="13"
                   Margin="4,0,0,10" />

        <!-- 4. Paged Search Results -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BrushBgCard}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,12"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Album Art or Placeholder -->
                                    <Border Grid.Column="0"
                                            Width="64"
                                            Height="64"
                                            CornerRadius="6"
                                            Background="{StaticResource BrushBgInput}">
                                        <Grid>
                                            <TextBlock Text="🎵"
                                                       FontSize="28"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding ArtUrl}"
                                                   Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <!-- Song Metadata -->
                                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="400"
                                                       VerticalAlignment="Center" />

                                            <Border Background="{StaticResource BrushSuccessSubtle}"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsIdealForUnplugged, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{DynamicResource Loc_Search_IdealTooltip}">
                                                <TextBlock Text="{DynamicResource Loc_Search_IdealBadge}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource BrushAccentGreen}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding SubtitleDisplay}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrushAccentBlue}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding MetaDisplay}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding ChartContentDisplay}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{DynamicResource Loc_Search_ChartMetadataTooltip}" />

                                        <Border Background="{StaticResource BrushBgInput}"
                                                CornerRadius="8"
                                                Padding="8,3"
                                                Margin="0,5,0,0"
                                                HorizontalAlignment="Left"
                                            ToolTip="{DynamicResource Loc_Search_TrackLayoutTooltip}">
                                            <TextBlock Text="{Binding TrackLayoutDisplay}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushAccentBlue}" />
                                        </Border>

                                        <Border Background="{StaticResource BrushWarningSubtle}"
                                                CornerRadius="8"
                                                Padding="8,3"
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding HasChartCoverageWarning, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{DynamicResource Loc_Search_IncompleteChartTooltip}">
                                            <TextBlock Text="{Binding ChartCoverageWarningDisplay}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushWarning}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Actions & Progress -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Width="180">
                                        <Button ContentTemplate="{StaticResource WrappingButtonContent}" Content="{Binding StatusText}"
                                                Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanDownload}"
                                                FontWeight="SemiBold"
                                                Margin="0,0,0,4" />

                                        <ProgressBar Value="{Binding DownloadProgress}"
                                                     Maximum="1.0"
                                                     Height="6"
                                                     Margin="0,2,0,0"
                                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,10,0,0">
                <Button ContentTemplate="{StaticResource WrappingButtonContent}" Content="{DynamicResource Loc_Search_PreviousPage}"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoToPreviousPage}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,12,0" />
                <TextBlock Text="{Binding PageInfoText}"
                           Foreground="{StaticResource BrushTextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Button ContentTemplate="{StaticResource WrappingButtonContent}" Content="{DynamicResource Loc_Search_NextPage}"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoToNextPage}"
                        Style="{StaticResource SecondaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
