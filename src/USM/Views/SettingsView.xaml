<UserControl x:Class="USM.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:USM.ViewModels"
             xmlns:local="clr-namespace:USM.Views"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             Background="Transparent">
    <UserControl.Resources>
        <local:StatusTextConverter x:Key="StatusTextConv" />
        <local:StatusColorConverter x:Key="StatusColorConv" />

        <Style x:Key="SpinnerBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10,20,20">
            <!-- 0. Language Settings Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_Settings_LanguageCardTitle}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource Loc_Settings_LanguageDesc}"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,0,0,14" />
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Loc_Settings_LanguageCardTitle}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Languages}"
                                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                  SelectedValuePath="Code"
                                  DisplayMemberPath="DisplayName"
                                  Height="36"
                                  VerticalContentAlignment="Center"
                                  FontSize="13" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 1. Game Path Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_Settings_GameDirTitle}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding GamePath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontSize="13"
                                 Margin="0,0,10,0" />

                        <Button ContentTemplate="{StaticResource WrappingButtonContent}" Grid.Column="1"
                                Content="{DynamicResource Loc_Settings_BrowseButton}"
                                Command="{Binding BrowseGamePathCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Mod & Installation Status Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Loc_Settings_ModStatusTitle}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />

                        <Button ContentTemplate="{StaticResource WrappingButtonContent}" Grid.Column="1"
                                Content="{DynamicResource Loc_Settings_InstallModButton}"
                                Command="{Binding InstallModCommand}"
                                Background="{StaticResource BrushAccentGreen}"
                                Foreground="#000000"
                                FontWeight="Bold" />
                    </Grid>

                    <!-- Status Rows -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Loc_Settings_GameExecLabel}" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding IsGameFound, Converter={StaticResource StatusTextConv}}" Foreground="{Binding IsGameFound, Converter={StaticResource StatusColorConv}}" FontWeight="Bold" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Loc_Settings_MelonLabel}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IsMelonInstalled, Converter={StaticResource StatusTextConv}}" Foreground="{Binding IsMelonInstalled, Converter={StaticResource StatusColorConv}}" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MelonInstallStatusMessage}" Foreground="{StaticResource BrushAccentYellow}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsInstallingMelon, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button ContentTemplate="{StaticResource WrappingButtonContent}" Content="{Binding MelonActionButtonText}"
                                    Command="{Binding InstallMelonCommand}"
                                    IsEnabled="{Binding CanInstallMelon}"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button ContentTemplate="{StaticResource WrappingButtonContent}" Content="{DynamicResource Loc_Settings_MelonUninstallBtn}"
                                    Command="{Binding UninstallMelonCommand}"
                                    Visibility="{Binding IsMelonInstalled, Converter={StaticResource BoolToVis}}"
                                    IsEnabled="{Binding CanInstallMelon}"
                                    Style="{StaticResource DangerButton}"
                                    Margin="6,0,0,0" />
                        </WrapPanel>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Loc_Settings_ModLabel}" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding IsModInstalled, Converter={StaticResource StatusTextConv}}" Foreground="{Binding IsModInstalled, Converter={StaticResource StatusColorConv}}" FontWeight="Bold" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Loc_Settings_CustomSongsFolderLabel}" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding IsCustomSongsReady, Converter={StaticResource StatusTextConv}}" Foreground="{Binding IsCustomSongsReady, Converter={StaticResource StatusColorConv}}" FontWeight="Bold" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Updates & GitHub Releases Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Loc_Settings_UpdatesTitle}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />

                        <Button ContentTemplate="{StaticResource WrappingButtonContent}" Grid.Column="1"
                                Content="{DynamicResource Loc_Settings_CheckUpdatesBtn}"
                                Command="{Binding CheckUpdatesCommand}"
                                Background="{StaticResource BrushAccentPurple}"
                                Foreground="#FFFFFF"
                                FontWeight="Bold" />
                    </Grid>

                    <!-- Version Rows -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Loc_Settings_CurrentAppVersion}" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentAppVersion}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Loc_Settings_InstalledModVersion}" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding InstalledPcModVersionText}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,4" Visibility="{Binding IsQuestModInstalled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Loc_Settings_InstalledQuestModVersion}" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding InstalledQuestModVersion}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Loc_Settings_LatestRelease}" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding LatestReleaseVersion}" Foreground="{StaticResource BrushAccentBlue}" FontWeight="Bold" />
                    </Grid>

                    <!-- Status Message -->
                    <TextBlock Text="{Binding UpdateStatusMessage}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               Margin="0,8,0,10"
                               TextWrapping="Wrap" />

                    <!-- Progress Bar for USM App Updating -->
                    <ProgressBar Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding UpdateProgress, Mode=OneWay}"
                                 Visibility="{Binding IsUpdatingApp, Converter={StaticResource BoolToVis}}"
                                 Foreground="{StaticResource BrushAccentPink}"
                                 Background="{StaticResource BrushBgInput}"
                                 BorderThickness="0"
                                 Margin="0,0,0,12" />

                    <!-- Action Buttons -->
                    <WrapPanel>
                        <Button ContentTemplate="{StaticResource WrappingButtonContent}" Content="{DynamicResource Loc_Settings_UpdateAppBtn}"
                                Command="{Binding UpdateAppCommand}"
                                Visibility="{Binding CanUpdateApp, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource BrushAccentPink}"
                                Foreground="#FFFFFF"
                                FontWeight="Bold"
                                Margin="0,0,10,0" />

                        <Button ContentTemplate="{StaticResource WrappingButtonContent}" Content="{DynamicResource Loc_Settings_ViewReleaseBtn}"
                                Command="{Binding OpenReleaseCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" />

                        <Button ContentTemplate="{StaticResource WrappingButtonContent}" Content="{DynamicResource Loc_Settings_DownloadModBtn}"
                                Command="{Binding DownloadModAssetCommand}"
                                Visibility="{Binding CanDownloadModAsset, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource BrushAccentGreen}"
                                Foreground="#000000"
                                FontWeight="Bold" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 3. Preferences & Debug Options Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_Settings_InGameSettingsTitle}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               Margin="0,0,0,14" />

                    <!-- Discord RPC Checkbox -->
                    <CheckBox IsChecked="{Binding EnableDiscordRpc}"
                              Content="{DynamicResource Loc_Settings_DiscordRpc}"
                              Foreground="{StaticResource BrushTextPrimary}"
                              FontSize="13"
                              Margin="0,0,0,12" />

                    <!-- Verbose Debug Checkbox -->
                    <CheckBox IsChecked="{Binding EnableVerboseDebug}"
                              Content="{DynamicResource Loc_Settings_VerboseLogging}"
                              Foreground="{StaticResource BrushTextPrimary}"
                              FontSize="13" />
                </StackPanel>
            </Border>

            <!-- 4. Song Manager Download Preferences Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_Settings_DownloadPrefsTitle}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               Margin="0,0,0,14" />

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Loc_Settings_MaxDownloadsLabel}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" />

                        <!-- Numeric Spinner Control (1 - 99) -->
                        <Border Grid.Column="1"
                                Background="{StaticResource BrushBgInput}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="34"
                                VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="MaxDownloadsBox"
                                         Grid.Column="0"
                                         Text="{Binding MaxDownloadsText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource BrushTextPrimary}"
                                         FontSize="14"
                                         FontWeight="Bold"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         MaxLength="2"
                                         Padding="0"
                                         PreviewTextInput="MaxDownloads_PreviewTextInput"
                                         DataObject.Pasting="MaxDownloads_Pasting"
                                         LostFocus="MaxDownloads_LostFocus" />

                                <Border Grid.Column="1"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0"
                                                Style="{StaticResource SpinnerBtn}"
                                                Command="{Binding IncrementDownloadsCommand}"
                                                ToolTip="{DynamicResource Loc_Settings_IncreaseTooltip}">
                                            <TextBlock Text="▲"
                                                       FontSize="8"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>

                                        <Rectangle Grid.Row="1" Fill="{StaticResource BrushBorder}" />

                                        <Button Grid.Row="2"
                                                Style="{StaticResource SpinnerBtn}"
                                                Command="{Binding DecrementDownloadsCommand}"
                                                ToolTip="{DynamicResource Loc_Settings_DecreaseTooltip}">
                                            <TextBlock Text="▼"
                                                       FontSize="8"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
