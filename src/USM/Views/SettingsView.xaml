<UserControl x:Class="USM.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:USM.ViewModels"
             xmlns:local="clr-namespace:USM.Views"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             Background="Transparent">
    <UserControl.Resources>
        <local:StatusTextConverter x:Key="StatusTextConv" />
        <local:StatusColorConverter x:Key="StatusColorConv" />

        <Style x:Key="SpinnerBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10,20,20">
            <!-- 1. Game Path Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Unplugged VR Game Location"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="Root folder where Unplugged.exe is installed on your PC:"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,3,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding GamePath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontSize="13"
                                 Margin="0,0,10,0" />

                        <Button Grid.Column="1"
                                Content="Browse Folder"
                                Command="{Binding BrowseGamePathCommand}"
                                Padding="16,8"
                                FontSize="12" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Mod & Installation Status Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Modding &amp; Installation Status"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="⚡ Install / Update Mod Plugin"
                                Command="{Binding InstallModCommand}"
                                Background="{StaticResource BrushAccentGreen}"
                                Foreground="#000000"
                                FontWeight="Bold"
                                Padding="16,8"
                                FontSize="12" />
                    </Grid>

                    <!-- Status Rows -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Unplugged.exe Executable:" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding IsGameFound, Converter={StaticResource StatusTextConv}}" Foreground="{Binding IsGameFound, Converter={StaticResource StatusColorConv}}" FontWeight="Bold" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MelonLoader (Mod Loader):" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding IsMelonInstalled, Converter={StaticResource StatusTextConv}}" Foreground="{Binding IsMelonInstalled, Converter={StaticResource StatusColorConv}}" FontWeight="Bold" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="UnpluggedCustomSongs.dll:" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding IsModInstalled, Converter={StaticResource StatusTextConv}}" Foreground="{Binding IsModInstalled, Converter={StaticResource StatusColorConv}}" FontWeight="Bold" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CustomSongs Library Folder:" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding IsCustomSongsReady, Converter={StaticResource StatusTextConv}}" Foreground="{Binding IsCustomSongsReady, Converter={StaticResource StatusColorConv}}" FontWeight="Bold" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Preferences & Debug Options Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16">
                <StackPanel>
                    <TextBlock Text="In-Game VR Mod Settings (MelonPreferences.cfg)"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="These options are executed exclusively by the in-game plugin (UnpluggedCustomSongs.dll) when playing in VR. USM does not run Discord RPC."
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,3,0,14" />

                    <!-- Discord RPC Checkbox -->
                    <CheckBox IsChecked="{Binding EnableDiscordRpc}"
                              Content="Enable In-Game Discord Rich Presence (Shows custom song &amp; difficulty on Discord while playing)"
                              Foreground="{StaticResource BrushTextPrimary}"
                              FontSize="13"
                              Margin="0,0,0,10" />

                    <!-- Verbose Debug Checkbox -->
                    <CheckBox IsChecked="{Binding EnableVerboseDebug}"
                              Content="Verbose / Debug In-Game Logging (Log detailed chart &amp; audio loading in MelonLoader console)"
                              Foreground="{StaticResource BrushTextPrimary}"
                              FontSize="13" />
                </StackPanel>
            </Border>

            <!-- 4. Song Manager Download Preferences Card -->
            <Border Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Song Manager Download Preferences"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="Configure parallel download and queue limits for Chorus Encore charts."
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,3,0,14" />

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Max Concurrent Downloads (1-99):"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" />

                        <!-- Numeric Spinner Control (1 - 99) -->
                        <Border Grid.Column="1"
                                Background="{StaticResource BrushBgInput}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="34"
                                VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="MaxDownloadsBox"
                                         Grid.Column="0"
                                         Text="{Binding MaxDownloadsText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource BrushTextPrimary}"
                                         FontSize="14"
                                         FontWeight="Bold"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         MaxLength="2"
                                         Padding="0"
                                         PreviewTextInput="MaxDownloads_PreviewTextInput"
                                         DataObject.Pasting="MaxDownloads_Pasting"
                                         LostFocus="MaxDownloads_LostFocus" />

                                <Border Grid.Column="1"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0"
                                                Style="{StaticResource SpinnerBtn}"
                                                Command="{Binding IncrementDownloadsCommand}"
                                                ToolTip="Increase">
                                            <TextBlock Text="▲"
                                                       FontSize="8"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>

                                        <Rectangle Grid.Row="1" Fill="{StaticResource BrushBorder}" />

                                        <Button Grid.Row="2"
                                                Style="{StaticResource SpinnerBtn}"
                                                Command="{Binding DecrementDownloadsCommand}"
                                                ToolTip="Decrease">
                                            <TextBlock Text="▼"
                                                       FontSize="8"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="2"
                                   Text="(Default: 5 - parallel chart downloads from Chorus Encore)"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
