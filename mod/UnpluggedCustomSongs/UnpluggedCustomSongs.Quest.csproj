<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <DefineConstants>QUEST_IL2CPP;IN_GAME_CHORUS</DefineConstants>
    <QuestReferencesDir Condition="'$(QuestReferencesDir)' == ''">$(MSBuildProjectDirectory)\..\..\tools\quest</QuestReferencesDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj/**/*.cs" />
    <Compile Remove="bin/**/*.cs" />
    <Compile Include="../../src/USM/Core/Parsers/ChartParser.cs" Link="Shared/ChartParser.cs" />
    <Compile Include="../../src/USM/Core/Parsers/MidiParser.cs" Link="Shared/MidiParser.cs" />
    <Compile Include="../../src/USM/Core/Parsers/JsonGenerator.cs" Link="Shared/JsonGenerator.cs" />
    <Compile Include="../../src/USM/Core/Parsers/ChartConversion.cs" Link="Shared/ChartConversion.cs" />
    <Compile Include="../../src/USM/Core/Parsers/SngDecoder.cs" Link="Shared/SngDecoder.cs" />
    <Compile Include="../../src/USM/Core/Services/AudioLayoutDetector.cs" Link="Shared/AudioLayoutDetector.cs" />
    <Compile Include="../../src/USM/Core/Parsers/XmlGenerator.cs" Link="Shared/XmlGenerator.cs" />
  </ItemGroup>

  <ItemGroup>
